# Configure locally or in the hosting platform. Never commit real values.
APP_ENV=development
DATABASE_URL=
# Preserve the currently effective signing key exactly; do not auto-generate on redeploy.
JWT_SECRET_KEY=
# Required only when SMS is requested; no client is initialized at startup.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=Smithsons
# Disable scheduler for local/staging tests; set explicitly on an approved production rollout.
FLEET_SCHEDULER_ENABLED=false
# Optional: only for the explicit create_users.py bootstrap script, not application startup.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DRIVER_PASSWORD=
